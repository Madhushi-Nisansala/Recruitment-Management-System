{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=RecruitmentManagementDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "RecruitmentManagementSystem",
    "Audience": "RecruitmentManagementSystem.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 30
  },
  "Authentication": {
    "AllowRecruiterRegistration": false
  }
}
